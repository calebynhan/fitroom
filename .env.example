# Copy to .env.local (and add the same keys in Vercel → Project → Settings → Environment Variables)
OPENAI_API_KEY=sk-...

# Paid try-ons (CLAUDE.md, "Paid try-ons"): off unless GOOGLE_CLIENT_ID, SESSION_SECRET and a ledger are all set.
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com   # Google Cloud > APIs & Services > Credentials > OAuth client (Web)
# SESSION_SECRET=                                        # 32+ random characters: openssl rand -base64 32
# KV_REST_API_URL=https://....upstash.io                 # set by Vercel's "Upstash for Redis" integration (not needed for vite dev)
# KV_REST_API_TOKEN=
# STRIPE_SECRET_KEY=sk_test_...                          # buying packs; without it the free looks still count
# STRIPE_WEBHOOK_SECRET=whsec_...                        # webhook https://<site>/api/stripe
# FREE_LOOKS=5
# PACK_LOOKS=20
# PACK_PRICE_CENTS=499
# PACK_CURRENCY=usd
# STRIPE_PRICE_ID=                                       # optional: a Stripe Price instead of PACK_PRICE_CENTS
# BILLING_EXEMPT_EMAILS=                                 # comma-separated accounts that never pay (the owner's is built in)
# BILLING_DISABLED=1                                     # kill switch: everything free again

# ChatGPT plugin (/api/mcp; CLAUDE.md "ChatGPT plugin" and "Accounts in the ChatGPT plugin"):
# FASHN_API_KEY=                                         # try-on photos in ChatGPT (FASHN API)
# TRYON_FREE_PER_MONTH=5                                 # per ChatGPT user, only while paid try-ons are off
# TRYON_DAILY_CAP=100                                    # photos a day for everyone
# With paid try-ons on, ChatGPT links the FitRoom account (OAuth) and spends its try-ons; also set:
# APP_URL=https://fitroom-woad.vercel.app                # one exact origin for the OAuth issuer and the MCP resource
# OAUTH_CLIENT_HOSTS=chatgpt.com,openai.com              # hosts allowed to identify ChatGPT with a client metadata document
