{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm --prefix web install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/product.ts": {
      "maxDuration": 20
    },
    "api/photoreal.ts": {
      "maxDuration": 120
    },
    "api/mcp.ts": {
      "maxDuration": 60,
      "includeFiles": "{web/public/catalog.json,api/_lib/mcp/widget.html}"
    }
  },
  "rewrites": [
    {
      "source": "/uniqlo/:path*",
      "destination": "https://image.uniqlo.com/:path*"
    }
  ],
  "cleanUrls": true
}
