{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm --prefix web install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/product.ts": {
      "maxDuration": 20
    },
    "api/photoreal.ts": {
      "maxDuration": 120
    },
    "api/account.ts": {
      "maxDuration": 15
    },
    "api/credits.ts": {
      "maxDuration": 15
    },
    "api/checkout.ts": {
      "maxDuration": 25
    },
    "api/stripe.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/uniqlo/:path*",
      "destination": "https://image.uniqlo.com/:path*"
    }
  ]
}
